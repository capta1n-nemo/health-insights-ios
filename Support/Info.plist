<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Health Insights</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- The static launch screen iOS shows the instant the icon is tapped,
         before a single line of app code runs. It was an empty dict, which
         renders plain white — and since the first SwiftUI frame cannot be drawn
         until AppModel has finished hydrating, that white screen was the first
         several seconds of every cold start.

         Colour only, deliberately. It carried UIImageName pointing at a poster
         of the heart, and the heart flashed in at roughly three times its size
         before the live view cut it down: the asset catalog declared the
         1179×2556 image in the *1x* slot, so iOS treated those numbers as
         points and drew it at 3× on a 3× screen, centred and cropped. The right
         fix looks like moving it to the 3x slot, but that is a guess about how
         UILaunchScreen scales, and a wrong guess here costs a deploy cycle to
         discover. A flat launch colour cannot be the wrong size.

         The cost is a beat of plain #D9D9D9 before the Metal view has its point
         cloud — the same colour the renderer clears to, so it reads as the app
         opening rather than as a blank screen. The poster image itself stays in
         the catalog for the Reduce Motion and no-Metal paths, where SwiftUI
         scales it correctly with .resizable().aspectRatio(contentMode: .fill). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- HealthKit usage strings (required for read authorization) -->
    <key>NSHealthShareUsageDescription</key>
    <string>Health Insights reads your heart rate, HRV, cardio fitness, blood pressure and body measurements to estimate your heart health, cardiovascular risk and blood pressure trends. Your data stays on your device.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Health Insights can save the readings you log, such as blood-pressure measurements, back to Apple Health.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Health Insights reads the times of your calendar events — never their titles, notes, attendees or locations — to work out how busy a day was and when you changed time zone. Nothing about your calendar leaves your device.</string>
    <key>NSCameraUsageDescription</key>
    <string>Health Insights uses the camera to scan a blood-test report so the values can be read on your device. The pages are read and discarded — no photo is saved, and nothing is uploaded.</string>

    <!-- Custom URL scheme used as the OAuth redirect target for Oura/Withings.
         Credentials are entered in-app and stored in the Keychain; there is no
         backend. -->

    <!-- Shotsy has no API, so its JSON backup *is* the integration: the user
         exports it and shares it to us. Claiming JSON as a document type is
         what puts this app in the share sheet and in "Open With".

         LSHandlerRank is "Alternate" deliberately. JSON is a generic type that
         many apps can open, and claiming Owner rank would make this app the
         default handler for every .json file on the phone — which it is not,
         and which would be an obnoxious thing to do to somebody who installed
         a health app. Alternate puts us in the list without taking it over.

         LSSupportsOpeningDocumentsInPlace is false: an import reads the file
         once and persists what it found. Opening in place would hand us a live
         reference to a file in another app's container that we neither edit
         nor own. -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Health data backup</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.shotsy.json</string>
                <string>public.json</string>
            </array>
        </dict>
    </array>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>


    <!-- Shotsy exports "data_080226.shotsyjson", and the share sheet calls it
         "Shotsy JSON Data" — so it is **not** public.json. Shotsy exports its
         own UTI for that extension, and a receiving app that only declares
         public.json is never offered the file, however valid the JSON inside
         it is.

         Importing the declaration is how a second app says it understands
         somebody else's type. Conformance to public.json is what lets the same
         document type keep working if Shotsy ever switches to a plain .json
         export. Discovered from the user's own share-sheet screenshot; the
         file extension was the whole answer. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.shotsy.json</string>
            <key>UTTypeDescription</key>
            <string>Shotsy JSON Data</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.json</string>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>shotsyjson</string>
                </array>
            </dict>
        </dict>
    </array>

    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.healthinsights.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>healthinsights</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
