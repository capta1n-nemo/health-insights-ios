<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Health Insights</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- The static launch screen iOS shows the instant the icon is tapped,
         before a single line of app code runs. It was an empty dict, which
         renders plain white — and since the first SwiftUI frame cannot be drawn
         until AppModel has finished hydrating, that white screen was the first
         several seconds of every cold start.

         Poster is the particle cloud at rest, rendered from the same
         LaunchParticleField arrangement the live Metal view starts from — which
         is why that field is seeded rather than random. UIImageRespectsSafeAreaInsets
         is absent (defaults false) so the image fills the screen the same way
         the renderer does. -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
        <key>UIImageName</key>
        <string>LaunchPoster</string>
    </dict>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- HealthKit usage strings (required for read authorization) -->
    <key>NSHealthShareUsageDescription</key>
    <string>Health Insights reads your heart rate, HRV, cardio fitness, blood pressure and body measurements to estimate your heart health, cardiovascular risk and blood pressure trends. Your data stays on your device.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Health Insights can save the readings you log, such as blood-pressure measurements, back to Apple Health.</string>

    <!-- Custom URL scheme used as the OAuth redirect target for Oura/Withings.
         Credentials are entered in-app and stored in the Keychain; there is no
         backend. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.healthinsights.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>healthinsights</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
