<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Health Insights</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- The static launch screen iOS shows the instant the icon is tapped,
         before a single line of app code runs. It was an empty dict, which
         renders plain white — and since the first SwiftUI frame cannot be drawn
         until AppModel has finished hydrating, that white screen was the first
         several seconds of every cold start.

         Colour only, deliberately. It carried UIImageName pointing at a poster
         of the heart, and the heart flashed in at roughly three times its size
         before the live view cut it down: the asset catalog declared the
         1179×2556 image in the *1x* slot, so iOS treated those numbers as
         points and drew it at 3× on a 3× screen, centred and cropped. The right
         fix looks like moving it to the 3x slot, but that is a guess about how
         UILaunchScreen scales, and a wrong guess here costs a deploy cycle to
         discover. A flat launch colour cannot be the wrong size.

         The cost is a beat of plain #D9D9D9 before the Metal view has its point
         cloud — the same colour the renderer clears to, so it reads as the app
         opening rather than as a blank screen. The poster image itself stays in
         the catalog for the Reduce Motion and no-Metal paths, where SwiftUI
         scales it correctly with .resizable().aspectRatio(contentMode: .fill). -->
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- HealthKit usage strings (required for read authorization) -->
    <key>NSHealthShareUsageDescription</key>
    <string>Health Insights reads your heart rate, HRV, cardio fitness, blood pressure and body measurements to estimate your heart health, cardiovascular risk and blood pressure trends. Your data stays on your device.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>Health Insights can save the readings you log, such as blood-pressure measurements, back to Apple Health.</string>

    <!-- Custom URL scheme used as the OAuth redirect target for Oura/Withings.
         Credentials are entered in-app and stored in the Keychain; there is no
         backend. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.healthinsights.oauth</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>healthinsights</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
