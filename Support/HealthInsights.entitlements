<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Standard HealthKit only. We deliberately do NOT request the clinical
         "Verifiable Health Records" access capability
         (com.apple.developer.healthkit.access): the app reads ordinary metrics
         (heart rate, HRV, VO2max, etc.), and that clinical entitlement is not
         available to free personal development teams. -->
    <key>com.apple.developer.healthkit</key>
    <true/>

    <!-- Shared with the ShotsyImportAction extension, which is the share
         sheet's bottom row. The extension copies a shared backup into this
         container and the app drains it on launch and on foreground; an
         extension has no other way to hand bytes to its containing app.

         Must match `SharedInbox.appGroupIdentifier` and the same key in
         Support/ShotsyImportAction.entitlements. A mismatch produces no error —
         just an inbox that is always empty.

         ⚠️ Not available to free personal development teams. If signing starts
         failing on the deploy Mac and names this capability, remove the
         extension target and both of these keys; nothing else depends on it. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.jasonsalway.healthinsights</string>
    </array>
</dict>
</plist>
