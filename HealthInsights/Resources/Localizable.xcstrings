    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ %@ not drawn — each is missing a score in at least one %@, and a shape can only be read against the shape beside it if every card on it has a real value. A coarser step usually brings them back.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ not drawn — each is missing a score in at least one %3$@, and a shape can only be read against the shape beside it if every card on it has a real value. A coarser step usually brings them back."
          }
        }
      }
    },
