{
  "permissions": {
    "allow": [
      "Bash(./scripts/bootstrap-swift.sh)",
      "Bash(./scripts/verify.sh*)",
      "Bash(./scripts/ci-status.sh*)",
      "Bash(./scripts/gen-symbol-index.sh)",
      "Bash(./scripts/where.sh*)",
      "Bash(source scripts/swift-env.sh*)",
      "Bash(cd InsightKit && swift *)",
      "Bash(swift *)",
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git ls-remote*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Read",
      "Edit",
      "Write",
      "Bash(./scripts/handover-check.sh*)",
      "Bash(./scripts/pre-push-gate.sh*)",
      "Bash(./scripts/backlog.sh*)",
      "Bash(./scripts/deploy-status.sh*)",
      "Bash(./scripts/card-map.sh*)",
      "Bash(cd \"/Users/jason.salway/health-insights-ios\")",
      "Bash(cd \"/home/user/health-insights-ios\")",
      "Bash(cd \"/Users/jason.salway/health-insights-ios/.claude/worktrees/*\")",
      "Bash(cd \"/home/user/health-insights-ios/.claude/worktrees/*\")",
      "Bash(cd /home/user/health-insights-ios)",
      "Bash(./scripts/simulator.sh*)",
      "Bash(xcrun *)",
      "Bash(xcodebuild *)",
      "Bash(open -a Simulator*)"
    ],
    "deny": [
      "Read(*.env*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/bash-workdir-hook.sh\"",
            "timeout": 10,
            "statusMessage": "Anchoring the shell to the repo root\u2026"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/pre-push-gate.sh\"",
            "if": "Bash(git push*)",
            "timeout": 420,
            "statusMessage": "Running the pre-push gate (verify.sh --tests)\u2026"
          }
        ]
      }
    ]
  }
}
